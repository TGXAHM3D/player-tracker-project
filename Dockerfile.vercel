# Vercel container image: runs the Streamlit app (Vercel routes traffic to $PORT, default 80).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=80

# System libraries OpenCV needs at runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# CPU-only PyTorch keeps the image far smaller (no CUDA on Vercel)
RUN pip install --index-url https://download.pytorch.org/whl/cpu torch torchvision

COPY player-tracker-project/requirements.txt .
RUN pip install -r requirements.txt

COPY player-tracker-project/ .

EXPOSE 80
CMD streamlit run player_tracker_final.py \
    --server.port=${PORT} --server.address=0.0.0.0 \
    --server.headless=true --server.enableCORS=false --server.enableXsrfProtection=false
